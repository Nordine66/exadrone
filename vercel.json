{
  "trailingSlash": false,
  "functions": {
    "api/quote.js": {
      "includeFiles": "node_modules/pdfkit/js/**"
    },
    "api/blog/content.js": {
      "includeFiles": "templates/**"
    },
    "api/admin/dashboard.js": {
      "maxDuration": 300,
      "includeFiles": "lib/data/**"
    },
    "api/agents/console-chat.js": {
      "maxDuration": 300
    },
    "api/agents/tasks.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/agents/tasks?agent=blog-writer",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/agents/tasks?agent=outreach&action=send-batch",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/agents/tasks?agent=followup",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    { "source": "/solaire.html", "destination": "/solaire", "permanent": true },
    { "source": "/nettoyage-toiture.html", "destination": "/nettoyage-toiture", "permanent": true },
    { "source": "/nettoyage-facade.html", "destination": "/nettoyage-facade", "permanent": true },
    { "source": "/blog/index.html", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/solaire",
      "destination": "/solaire.html"
    },
    {
      "source": "/nettoyage-toiture",
      "destination": "/nettoyage-toiture.html"
    },
    {
      "source": "/nettoyage-facade",
      "destination": "/nettoyage-facade.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog",
      "destination": "/api/blog/content?resource=index"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/content?resource=article&slug=:slug"
    },
    {
      "source": "/api/blog/listing",
      "destination": "/api/blog/content?resource=listing"
    },
    {
      "source": "/api/roof-photo/:id",
      "destination": "/api/admin/dashboard?resource=roof-photo&id=:id"
    },
    {
      "source": "/api/admin/roofs",
      "destination": "/api/admin/dashboard?resource=roofs"
    },
    {
      "source": "/api/admin/stats",
      "destination": "/api/admin/dashboard?resource=stats"
    },
    {
      "source": "/api/admin/leads",
      "destination": "/api/admin/dashboard?resource=leads"
    },
    {
      "source": "/api/admin/agents",
      "destination": "/api/admin/dashboard?resource=agents"
    },
    {
      "source": "/api/admin/prospects",
      "destination": "/api/admin/dashboard?resource=prospects"
    },
    {
      "source": "/api/admin/emails",
      "destination": "/api/admin/dashboard?resource=emails"
    },
    {
      "source": "/api/admin/analytics",
      "destination": "/api/admin/dashboard?resource=analytics"
    },
    {
      "source": "/api/admin/exclusions",
      "destination": "/api/admin/dashboard?resource=exclusions"
    },
    {
      "source": "/api/admin/duplicates",
      "destination": "/api/admin/dashboard?resource=duplicates"
    },
    {
      "source": "/api/admin/quotes",
      "destination": "/api/admin/dashboard?resource=quotes"
    },
    {
      "source": "/api/agents/blog-writer",
      "destination": "/api/agents/tasks?agent=blog-writer"
    },
    {
      "source": "/api/agents/outreach",
      "destination": "/api/agents/tasks?agent=outreach"
    }
  ],
  "headers": [
    {
      "source": "/templates/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.webm|.*\\.mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/chat-widget.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/script.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
